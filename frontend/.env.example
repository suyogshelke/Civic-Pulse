# ---------------------------------------------------------------------------
# Civic-Pulse frontend environment configuration
# Copy this file to `.env` and adjust as required.
# ---------------------------------------------------------------------------

# Base URL of the Spring Boot REST API.
# Left as /api so that the Vite dev-server proxy (see vite.config.js) forwards
# requests to http://localhost:8080 without triggering CORS.
VITE_API_BASE_URL=/api

# Run the app WITHOUT the Java backend.
# true  -> all API calls are served by the in-browser mock service layer
#          (src/api/mock). The app is fully usable with seeded demo data.
# false -> API calls go to the real Spring Boot backend.
VITE_USE_MOCK_API=true

# Simulated network latency in milliseconds for the mock layer, so loading
# states and spinners behave realistically during a demo.
VITE_MOCK_LATENCY=350

VITE_APP_NAME=Civic-Pulse
